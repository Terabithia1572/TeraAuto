<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.terabithia.teracontrol">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <queries>
        <package android:name="com.terabithia.teraauto"/>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService"/>
        </intent>
        <intent>
            <action android:name="me.aap.fermata.action.CarMediaService"/>
        </intent>
        <intent>
            <action android:name="me.aap.fermata.action.ControlService"/>
        </intent>
        <intent>
            <action android:name="me.aap.fermata.action.MediaService"/>
        </intent>
    </queries>
    <permission android:name="com.terabithia.teracontrol.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" android:protectionLevel="signature"/>
    <uses-permission android:name="com.terabithia.teracontrol.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"/>
    <application android:appComponentFactory="androidx.core.app.CoreComponentFactory" android:extractNativeLibs="false" android:icon="@drawable/control" android:label="@string/app_name" android:launchMode="singleTop" android:name="android.app.Application" android:supportsRtl="true">
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc"/>
        <service android:exported="true" android:foregroundServiceType="mediaPlayback" android:name="me.aap.fermata.auto.control.FermataMediaServiceControl">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH"/>
            </intent-filter>
            <intent-filter>
                <action android:name="me.aap.fermata.action.ControlService"/>
            </intent-filter>
        </service>
        <receiver android:exported="false" android:name="androidx.media.session.MediaButtonReceiver">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
